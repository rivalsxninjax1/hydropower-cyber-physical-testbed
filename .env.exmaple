# Copy this file to .env and adjust if needed. docker-compose.yml
# currently sets PLC_HOST/PLC_PORT directly rather than reading from
# .env, so this file is documentation of the available settings for
# now — it becomes load-bearing once more services (attacker tools,
# IDS, etc.) need their own configurable connection details in later
# phases.

# Dashboard -> PLC connection (used by dashboard/backend/main.py)
PLC_HOST=127.0.0.1
PLC_PORT=5020